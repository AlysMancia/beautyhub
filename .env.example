# Copied to .env by setup.bat. Read by docker compose AND Next.js.

# --- PostgreSQL ---
DB_NAME=beautyhub
DB_USER=beautyhub
DB_PASSWORD=beautyhub
DB_PORT=5432

# --- pgAdmin (http://localhost:5052) ---
PGADMIN_EMAIL=admin@beautyhub.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5052

# --- PHP backend (runs in Docker) ---
PHP_PORT=8088
PHP_BACKEND_URL=http://localhost:8088/php/main.php

# --- WebSocket server ---
WS_PORT=3001
WS_BROADCAST_SECRET=change-me
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# --- Default seller (you). seed-owner.bat creates this account on setup/start. ---
# Leave OWNER_EMAIL empty to skip. Changing OWNER_PASSWORD and running start.bat updates the password.
OWNER_NAME=Your Name
OWNER_USERNAME=yourusername
OWNER_EMAIL=
OWNER_PASSWORD=change-this-password
OWNER_STORE_NAME=Manciare Trends
OWNER_STORE_SLUG=manciare-trends
# Add the products from database/seeds/default_products.sql to this store (once).
OWNER_SEED_PRODUCTS=true

# The store shown on the main page (/). Leave empty to show the general login/signup page.
NEXT_PUBLIC_DEFAULT_STORE_SLUG=manciare-trends

# Timezone used for promo "valid until" dates.
APP_TIMEZONE=Asia/Manila
